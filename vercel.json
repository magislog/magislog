{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/games(?:/.*)?$",
      "status": 404,
      "dest": "/404.html",
      "caseSensitive": false
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/illustrations/([a-z0-9-]+)/?$",
      "dest": "/illustrations/index.html"
    }
  ]
}
